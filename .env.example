# Environment Variables Template
# Copy this file to .env and customize with your values
# IMPORTANT: Never commit the .env file to version control

# ============================================================================
# Network Configuration
# ============================================================================

# Host network mode (uncomment to enable)
# USE_HOST_NETWORK=true

# Proxy settings (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ============================================================================
# Tool Configuration
# ============================================================================

# Metasploit database credentials
POSTGRES_USER=msf
POSTGRES_PASSWORD=msf
POSTGRES_DB=msf
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================================
# API Keys and Credentials
# ============================================================================

# Shodan API key (for reconnaissance)
# SHODAN_API_KEY=your_shodan_api_key_here

# VirusTotal API key (for malware analysis)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Have I Been Pwned API key
# HIBP_API_KEY=your_hibp_api_key_here

# SecurityTrails API key (for DNS/domain research)
# SECURITYTRAILS_API_KEY=your_securitytrails_api_key_here

# Censys API credentials
# CENSYS_API_ID=your_censys_api_id
# CENSYS_API_SECRET=your_censys_api_secret

# ============================================================================
# Target Configuration
# ============================================================================

# Default target settings (for testing)
# TARGET_HOST=192.168.1.100
# TARGET_PORT=80
# TARGET_URL=https://example.com

# ============================================================================
# Project Settings
# ============================================================================

# Project name
PROJECT_NAME=security-assessment

# Output directory
OUTPUT_DIR=./results

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================================
# VPN Configuration
# ============================================================================

# OpenVPN configuration
# OVPN_CONFIG=/path/to/config.ovpn
# OVPN_USERNAME=your_username
# OVPN_PASSWORD=your_password

# WireGuard configuration
# WG_CONFIG=/path/to/wg0.conf

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode
# DEBUG=true

# Python virtual environment path
# VENV_PATH=.venv

# ============================================================================
# Container Settings
# ============================================================================

# Container user
CONTAINER_USER=kali

# Workspace directory
WORKSPACE=/workspace

# ============================================================================
# Security Settings
# ============================================================================

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
# ENCRYPTION_KEY=your_32_byte_hex_key_here

# Password for protected archives/files
# ARCHIVE_PASSWORD=your_secure_password

# ============================================================================
# Notes
# ============================================================================

# 1. Generate secure random passwords:
#    openssl rand -base64 32

# 2. Generate encryption keys:
#    openssl rand -hex 32

# 3. Never share this file or commit it to version control

# 4. Keep backups in a secure location

# 5. Rotate credentials regularly

# 6. Use different credentials for different projects/clients
